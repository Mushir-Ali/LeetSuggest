{
    "manifest_version": 3,
    "name": "LeetSuggest",
    "version": "1.0",
    "icons": { "128": "icon128.png" },
    "description": "Autocomplete for identifiers you've declared in the LeetCode editor.",
    "content_scripts": [
        {
            "matches": ["https://leetcode.com/problems/*"],
            "js": ["index.js"],
            "world": "MAIN"
        }
    ]
}